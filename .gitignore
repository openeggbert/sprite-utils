#files to ignore

*.metadata/**
*.recommenders/**
*target/**
*build/**
*.idea/**
*.iml

# generated by SpriteSheet (written next to whatever CSV was parsed)
*.computed.csv
# generated by the `extract` command's default --out-dir
/extracted/
**/extracted/
# generated GIF batches (derived from copyrighted game assets - keep local,
# don't redistribute through the repo, see analysis.md §8)
/gifs_output/
/gen/

# Phase 3 deliverables (draw/extract/gifs full-corpus output) - derived
# from copyrighted game assets, kept local only, same reasoning as above
/tmp/

# generated by importing tools/*.py as a module (e.g. from another script)
tools/__pycache__/

